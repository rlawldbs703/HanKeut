# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않아요)
# 값이 비어 있으면 AI 미연결 상태로 표시돼요. (미니띠니 대화 불가, 게임은 기본 편지)

# 틸론 GPU API 주소 (OpenAI 호환, 예: https://xxx.ac.kr/v1)
TILON_API_BASE_URL=
# 틸론 API 키 (절대 공개 금지)
TILON_API_KEY=
# 사용할 모델 이름 (예: Qwen2.5-7B-Instruct)
TILON_MODEL=

# (선택) 틸론 대신 쓸 OpenAI 호환 LLM API — 틸론 설정이 있으면 틸론이 우선이에요.
# 예: Vercel AI Gateway → https://ai-gateway.vercel.sh/v1 , OpenAI → https://api.openai.com/v1
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
